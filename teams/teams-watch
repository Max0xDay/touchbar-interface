#!/usr/bin/env python3
"""Event-driven Teams panel source. One browser CDP connection; no target polling.
--dry-run prints changed messages instead of contacting MTMR. Only loopback networking.
"""
import argparse
import http.client
import json
from pathlib import Path
import runpy
import select
import signal
import socket
import sys
import time
from urllib.parse import urlparse

cdp = runpy.run_path(str(Path(__file__).resolve().with_name("teams-cdp.py")))


def observerScript():
    deviceReaders = []
    for device in ("mic", "camera"):
        deviceReaders.append("function %sState() { %s %s }" % (
            device, cdp["find_button_script"](device),
            'if (!button) return "no-call"; var text = button.getAttribute("aria-label") || "";'
            'var states = %s; for (var state of states) { if (new RegExp(state[0], "i").test(text)) return state[1]; } return "unknown";' % json.dumps(cdp["DEVICES"][device]["states"])))
    # #COMPLETION_DRIVE: Teams exposes its timer through one of these data-tid values, and document.hasFocus follows the meeting window.
    # #SUGGEST_VERIFY: Inspect the timer and focus/blur events in a real call; joinedAt remains the fallback when no timer matches.
    # #COMPLETION_DRIVE: A hangup control or known mic/camera label denotes a call, matching the existing one-shot detection.
    # #SUGGEST_VERIFY: Confirm pre-join/settings controls do not match, and leaving a call removes all matching controls.
    return """(() => {
      if (window.top !== window) return;
      if (window.mtmrTeamsObserver?.version === 2) { window.mtmrTeamsObserver.report(true); return; }
      %s
      let previous = "";
      const report = (force = false) => {
        const mic = micState(), camera = cameraState();
        const timer = document.querySelector('[data-tid="call-duration"], [data-tid="call-timer"], [data-tid="call-duration-text"]');
        const duration = timer ? (timer.textContent || "").trim() : "";
        const snapshot = JSON.stringify({
          inCall: !!document.querySelector('[data-tid="hangup-main-btn"]') || mic !== "no-call" || camera !== "no-call",
          mic, camera, title: document.title, focused: document.hasFocus() && document.visibilityState === "visible",
          durationText: /^(?:\\d+:)?\\d{1,2}:\\d{2}$/.test(duration) ? duration : null
        });
        if (force === true || snapshot !== previous) { previous = snapshot; window.mtmrTeamsState(snapshot); }
      };
      let scheduled = false;
      const observer = new MutationObserver(() => {
        if (scheduled) return;
        scheduled = true;
        queueMicrotask(() => { scheduled = false; report(); });
      });
      observer.observe(document, {subtree: true, childList: true, characterData: true,
        attributes: true, attributeFilter: ["aria-label", "data-tid"]});
      window.addEventListener("focus", report);
      window.addEventListener("blur", report);
      document.addEventListener("visibilitychange", report);
      window.mtmrTeamsObserver = {report, version: 2};
      report(true);
    })()""" % "\n".join(deviceReaders)


def mappedState(snapshot, title, joinedAt):
    inCall = snapshot.get("inCall") is True
    microphone = {"unmuted": "on", "muted": "muted"}.get(snapshot.get("mic"), "unknown")
    camera = snapshot.get("camera")
    if camera not in ("on", "off"):
        camera = "unknown"
    return {"cmd": "teams", "online": True, "inCall": inCall,
            "title": title if inCall else "", "mic": microphone, "camera": camera,
            "focused": inCall and snapshot.get("focused") is True,
            "joinedAt": joinedAt if inCall else None, "durationText": snapshot.get("durationText")}


def applyState(socketPath, command):
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
        connection.settimeout(2)
        connection.connect(socketPath)
        connection.sendall(json.dumps(command, separators=(",", ":")).encode() + b"\n")
        replyBytes = bytearray()
        while b"\n" not in replyBytes:
            received = connection.recv(1024)
            if not received:
                raise ValueError("MTMR closed without reply")
            replyBytes.extend(received)
            if len(replyBytes) > 4096:
                raise ValueError("MTMR reply exceeds 4096 bytes")
        reply = json.loads(replyBytes.split(b"\n", 1)[0])
        if not isinstance(reply, dict) or reply.get("ok") is not True:
            raise ValueError("MTMR rejected command: %s" % reply)


class Publisher:
    def __init__(self, arguments):
        self.arguments = arguments
        self.pending = None
        self.retryAt = None
        self.previous = None

    def publish(self, command):
        if command == self.previous:
            return
        self.previous = command
        if self.arguments.dry_run:
            print(json.dumps(command, separators=(",", ":")), flush=True)
            return
        if command["cmd"] == "teams":
            self.pending = command
        self.deliver(command)

    def deliver(self, command):
        try:
            applyState(self.arguments.socket, command)
            if command == self.pending:
                self.pending = None
                self.retryAt = None
        except (OSError, ValueError, UnicodeError) as error:
            print("teams-watch: delivery failed: %s" % error, file=sys.stderr)
            # Notifications are not retried: a lost reply must not duplicate a join toast.
            if self.pending is not None:
                self.retryAt = time.monotonic() + 5

    def retry(self):
        if self.retryAt is not None and time.monotonic() >= self.retryAt:
            self.deliver(self.pending)


def browserConnection(port):
    connection = http.client.HTTPConnection("127.0.0.1", port, timeout=3)
    try:
        connection.request("GET", "/json/version")
        response = connection.getresponse()
        if response.status != 200:
            raise ValueError("version endpoint returned HTTP %d" % response.status)
        version = json.loads(response.read(1024 * 1024))
    finally:
        connection.close()
    endpoint = urlparse(version["webSocketDebuggerUrl"])
    if endpoint.hostname != "127.0.0.1" or endpoint.port != port:
        raise ValueError("browser websocket must use the configured loopback port")
    return cdp["WebSocketConnection"](port, endpoint.path, cdp["Deadline"](3))


class TeamsWatcher:
    def __init__(self, connection, publish, joined=None):
        self.connection = connection
        self.publish = publish
        self.requestIdentifier = 0
        self.pending = {}
        self.targets = {}
        self.sessions = {}
        self.states = {}
        self.joined = joined if joined is not None else {}
        self.discoveryFinished = True
        self.attaching = set()
        self.lastState = None

    def send(self, method, parameters=None, session=None, callback=None):
        self.requestIdentifier += 1
        request = {"id": self.requestIdentifier, "method": method, "params": parameters or {}}
        if session is not None:
            request["sessionId"] = session
        self.pending[self.requestIdentifier] = (time.monotonic() + 5, callback)
        self.connection.deadline = cdp["Deadline"](3)
        self.connection.send_text(json.dumps(request))

    def processMessage(self, message):
        if "id" in message:
            _, callback = self.pending.pop(message["id"], (None, None))
            if "error" in message:
                raise ValueError("CDP command failed: %s" % message["error"])
            if callback is not None:
                callback(message.get("result", {}))
            return
        method = message.get("method", "")
        parameters = message.get("params", {})
        if method in ("Target.targetCreated", "Target.targetInfoChanged"):
            self.targetChanged(parameters["targetInfo"])
        elif method == "Target.targetDestroyed":
            self.removeTarget(parameters["targetId"])
        elif method == "Target.detachedFromTarget":
            session = self.sessions.pop(parameters.get("sessionId"), None)
            if session is not None:
                identifier = session["targetId"]
                target = self.targets.get(identifier)
                self.attaching.discard(identifier)
                if target is not None:
                    self.targetChanged(target)
        else:
            self.pageEvent(method, parameters, message.get("sessionId"))

    def targetChanged(self, target):
        identifier = target["targetId"]
        candidate = dict(target, id=identifier)
        if not cdp["is_candidate_target"](candidate):
            if identifier in self.targets:
                self.removeTarget(identifier)
            return
        self.targets[identifier] = target
        if identifier in self.attaching:
            self.emitState()
            return
        self.attaching.add(identifier)
        self.send("Target.attachToTarget", {"targetId": identifier, "flatten": True},
                  callback=lambda reply: self.attached(identifier, reply))

    def attached(self, identifier, reply):
        session = reply["sessionId"]
        self.sessions[session] = {"targetId": identifier}
        self.send("Runtime.addBinding", {"name": "mtmrTeamsState"}, session)
        self.send("Page.enable", session=session)
        self.send("Page.addScriptToEvaluateOnNewDocument", {"source": observerScript()}, session)
        self.send("Runtime.enable", session=session)
        self.inject(session)

    def inject(self, session, contextIdentifier=None):
        parameters = {"expression": observerScript()}
        if contextIdentifier is not None:
            parameters["contextId"] = contextIdentifier
        self.send("Runtime.evaluate", parameters, session, self.evaluated)

    @staticmethod
    def evaluated(reply):
        if "exceptionDetails" in reply:
            raise ValueError("Teams observer injection failed: %s" % reply["exceptionDetails"].get("text"))

    def pageEvent(self, method, parameters, session):
        if session not in self.sessions:
            return
        if method == "Runtime.executionContextCreated":
            context = parameters.get("context", {})
            if context.get("auxData", {}).get("isDefault") is True:
                self.inject(session, context["id"])
        elif method == "Page.frameNavigated":
            if "parentId" not in parameters.get("frame", {}):
                self.inject(session)
        elif method == "Runtime.bindingCalled":
            if parameters.get("name") == "mtmrTeamsState":
                snapshot = json.loads(parameters["payload"])
                if not isinstance(snapshot, dict):
                    raise ValueError("Teams binding payload must be an object")
                self.receiveSnapshot(self.sessions[session]["targetId"], snapshot)

    def receiveSnapshot(self, identifier, snapshot):
        self.states[identifier] = snapshot
        if snapshot.get("inCall") is True:
            if identifier not in self.joined:
                self.joined[identifier] = time.time()
                self.publish({"cmd": "notify", "title": "Meeting joined", "text": self.title(identifier) or "Microsoft Teams",
                              "seconds": 15, "app": "com.microsoft.teams2"})
        else:
            self.joined.pop(identifier, None)
        self.emitState()

    def title(self, identifier):
        pageTitle = cdp["meeting_title"](self.states.get(identifier, {}))
        return pageTitle or cdp["meeting_title"](self.targets.get(identifier, {}))

    def removeTarget(self, identifier):
        self.targets.pop(identifier, None)
        self.states.pop(identifier, None)
        self.joined.pop(identifier, None)
        self.attaching.discard(identifier)
        self.sessions = {key: value for key, value in self.sessions.items() if value["targetId"] != identifier}
        self.emitState()

    def emitState(self):
        if not self.discoveryFinished:
            return
        calls = [identifier for identifier, snapshot in self.states.items() if snapshot.get("inCall") is True]
        if not calls:
            if any(identifier not in self.states for identifier in self.targets):
                return
            for identifier in list(self.joined):
                if identifier not in self.targets:
                    self.joined.pop(identifier)

        # #COMPLETION_DRIVE: If Teams exposes multiple call pages, prefer the focused one, otherwise the first live call.
        # #SUGGEST_VERIFY: Verify target identity during pop-out/window transitions in a real meeting.
        identifier = next((identifier for identifier in calls if self.states[identifier].get("focused") is True), calls[0] if calls else None)
        command = mappedState(self.states.get(identifier, {}), self.title(identifier), self.joined.get(identifier))
        if command != self.lastState:
            self.lastState = command
            self.publish(command)

    def discovered(self, _):
        self.discoveryFinished = True
        self.emitState()

    def run(self, publisher):
        self.discoveryFinished = False
        self.send("Target.setDiscoverTargets", {"discover": True}, callback=self.discovered)
        while True:
            deadlines = [deadline for deadline, _ in self.pending.values()]
            if publisher.retryAt is not None:
                deadlines.append(publisher.retryAt)
            timeout = max(0, min(deadlines) - time.monotonic()) if deadlines else None
            # Idle path: no pending CDP commands or deliveries => select blocks indefinitely; no target listing or timer.
            readable, _, _ = select.select([self.connection.socket], [], [], timeout)
            if readable:
                self.connection.deadline = cdp["Deadline"](3)
                self.processMessage(json.loads(self.connection.receive_text()))
            publisher.retry()
            if any(deadline <= time.monotonic() for deadline, _ in self.pending.values()):
                raise ValueError("CDP command timed out")


def parseArguments():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--socket", default=str(Path.home() / "Library/Application Support/MTMR/mtmr.sock"))
    return parser.parse_args()


def main():
    arguments = parseArguments()
    publisher = Publisher(arguments)
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    signal.signal(signal.SIGINT, lambda *_: sys.exit(0))
    backoffSeconds = 5
    joined = {}
    while True:
        connection = None
        connectedAt = time.monotonic()
        try:
            connection = browserConnection(cdp["read_debug_port"]())
            TeamsWatcher(connection, publisher.publish, joined).run(publisher)
        except (cdp["CdpError"], OSError, ValueError, KeyError, http.client.HTTPException) as error:
            print("teams-watch: disconnected: %s" % error, file=sys.stderr)
            publisher.publish({"cmd": "teams", "online": False, "inCall": False})
        finally:
            if connection is not None:
                connection.close()
        if time.monotonic() - connectedAt >= 30:
            backoffSeconds = 5
        time.sleep(backoffSeconds)
        backoffSeconds = min(30, 10 if backoffSeconds == 5 else 30)


if __name__ == "__main__":
    main()
