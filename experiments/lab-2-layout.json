  // ===== RIGHT edge of the MTMR area: fixed. Apple's own control strip sits to the right of this =====
  {
    // Teams mic: green = unmuted, red = muted, yellow = cannot read state, HIDDEN when not in a call. Tap toggles mute.
    "type": "shellScriptTitledButton",
    "align": "right",
    "width": 76,
    "refreshInterval": 1,
    "source": { "filePath": "/Users/maxday/Workspace/projects/maxlaptopmtmr/touchbar-interface/experiments/mic-status.sh" },
    "actions": [
      {
        "trigger": "singleTap",
        "action": "shellScript",
        "executablePath": "/Users/maxday/Workspace/projects/maxlaptopmtmr/touchbar-interface/teams/teams-mute",
        "shellArguments": ["toggle"]
      }
    ]
  },
  {
    // Drill-down pattern: tap opens a sub-bar, the close button returns.
    "type": "group",
    "title": "tools",
    "align": "right",
    "items": [
      { "type": "staticButton", "title": "tool 1", "background": "#444444" },
