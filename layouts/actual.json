  {
    "type": "appControls",
    "align": "right",
    "width": 340,
    "switcher": "right",
    "panels": ["system", "teams", "ytmusic", "praatvol", "stats", "fan"],
    "watcher": ["${REPO}/teams/teams-watch"],
    "teams": {"directory": "${REPO}/teams"},
    "praatvol": {"app": "dev"}
  }
]
