[
  {
    "type": "volume",
    "align": "left",
    "width": 30,
    "id": "volume"
  },
  {
    "type": "staticButton",
    "title": "",
    "align": "left",
    "bordered": false,
    "width": 1
  },
  {
    "type": "notification",
    "align": "center",
