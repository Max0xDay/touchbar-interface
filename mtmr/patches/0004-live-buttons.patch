+func validateLiveButtonIds(_ definitions: [BarItemDefinition]) throws {
+    var ids = Set<String>()
+    try collectLiveButtonIds(definitions, ids: &ids)
+}
+
+private func collectLiveButtonIds(_ definitions: [BarItemDefinition], ids: inout Set<String>) throws {
+    for definition in definitions {
+        if let id = definition.liveButton?.id {
+            guard ids.insert(id).inserted else { throw LiveButtonError(message: "duplicate button id: \(id)") }
+        }
+        if case let .group(items) = definition.type { try collectLiveButtonIds(items, ids: &ids) }
+    }
+}
