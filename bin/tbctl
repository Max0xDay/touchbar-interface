#!/usr/bin/env python3
"""Push notifications to MTMR (Python 3 standard library only).

Protocol: AF_UNIX/SOCK_STREAM, one UTF-8 JSON object per newline, at most
4096 bytes excluding newline. Commands: {"cmd":"notify","text":"...",
"seconds":5} (seconds optional, positive, <=86400), {"cmd":"clear"}.
Each command gets {"ok":true} or {"ok":false,"error":"..."} plus newline.
Unknown fields are reserved for extensions; unknown commands are rejected.
Default socket: ~/Library/Application Support/MTMR/mtmr.sock (mode 0600).
--socket PATH overrides it for testing. --dry-run never connects.
Exit: 0 success, 3 missing/refused socket, 2 usage, 1 server/transport error.
Five-second timeout; no automatic retry, to avoid duplicate notifications.
"""

import argparse
import errno
import json
import math
from pathlib import Path
import socket
import sys


def parseArguments():
    sharedOptions = argparse.ArgumentParser(add_help=False)
    sharedOptions.add_argument("--dry-run", action="store_true", default=argparse.SUPPRESS)
    sharedOptions.add_argument("--socket", metavar="PATH", default=argparse.SUPPRESS)
    parser = argparse.ArgumentParser(description=__doc__, parents=[sharedOptions])
    commands = parser.add_subparsers(dest="command", required=True)
    notificationParser = commands.add_parser("notify", parents=[sharedOptions])
    notificationParser.add_argument("text")
    notificationParser.add_argument("--seconds", type=float)
    commands.add_parser("clear", parents=[sharedOptions])
    arguments = parser.parse_args()
    command = {"cmd": arguments.command}
    if arguments.command == "notify":
        command["text"] = arguments.text
        if arguments.seconds is not None:
            if not math.isfinite(arguments.seconds):
                parser.error("--seconds must be finite")
            if arguments.seconds <= 0:
                parser.error("--seconds must be positive")
            if arguments.seconds > 86400:
                parser.error("--seconds must not exceed 86400")
            command["seconds"] = arguments.seconds
    commandJson = json.dumps(command, ensure_ascii=False, separators=(",", ":"))
    if len(commandJson.encode("utf-8")) > 4096:
        parser.error("command exceeds the 4096-byte protocol limit")
    return arguments, commandJson


def receiveReply(connection):
    replyBytes = bytearray()
    while True:
        received = connection.recv(1024)
        if not received:
            raise ValueError("server closed without a complete reply")
        replyBytes.extend(received)
        newlineIndex = replyBytes.find(b"\n")
        if newlineIndex >= 0:
            if newlineIndex > 4096:
                raise ValueError("server reply exceeds 4096 bytes")
            reply = json.loads(replyBytes[:newlineIndex])
            if not isinstance(reply, dict):
                raise ValueError("server reply must be a JSON object")
            if type(reply.get("ok")) is not bool:
                raise ValueError("server reply requires a boolean ok field")
            return reply
        if len(replyBytes) > 4096:
            raise ValueError("server reply exceeds 4096 bytes")


def main():
    arguments, commandJson = parseArguments()
    if getattr(arguments, "dry_run", False):
        print(commandJson)
        return 0
    defaultSocketPath = Path.home() / "Library/Application Support/MTMR/mtmr.sock"
    socketPath = str(Path(getattr(arguments, "socket", defaultSocketPath)).expanduser())
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
            connection.settimeout(5)
            connection.connect(socketPath)
            connection.sendall(commandJson.encode("utf-8") + b"\n")
            reply = receiveReply(connection)
        if reply["ok"]:
            return 0
        print(f"tbctl: {reply.get('error', 'server rejected command')}", file=sys.stderr)
        return 1
    except OSError as error:
        print(f"tbctl: {error}", file=sys.stderr)
        if error.errno in (errno.ENOENT, errno.ECONNREFUSED):
            return 3
        return 1
    except (ValueError, UnicodeError) as error:
        print(f"tbctl: invalid server reply: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
